    <vuln:Title>.NET Security Feature Bypass Vulnerability</vuln:Title>
    <vuln:Notes>
      <vuln:Note
        Title="Description"
        Type="Description"
        Ordinal="0">&lt;p&gt;Improper verification of cryptographic signature in .NET allows an unauthorized attacker to bypass a security feature over a network.&lt;/p&gt;
</vuln:Note>

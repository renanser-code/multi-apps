  <vuln:Vulnerability
    Ordinal="553">
    <vuln:Title>Windows Active Directory Federation Services Denial of Service Vulnerability</vuln:Title>
    <vuln:Notes>
      <vuln:Note
        Title="Description"
        Type="Description"
        Ordinal="0">&lt;p&gt;Stack-based buffer overflow in Active Directory Federation Services allows an unauthorized attacker to deny service over a network.&lt;/p&gt;
</vuln:Note>
      <vuln:Note
        Title="FAQ"
        Type="FAQ"
        Ordinal="10">&lt;p&gt;&lt;strong&gt;According to the CVSS metrics, successful exploitation of this vulnerability could lead to major loss of availability (A:H). What does that mean for this vulnerability?&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;An attacker can send specially crafted packets which could affect availability of the service and result in Denial of Service (DoS).&lt;/p&gt;
</vuln:Note>
      <vuln:Note
        Title="Active Directory Federation Services (AD FS)"
        Type="Tag"
        Ordinal="20">Active Directory Federation Services (AD FS)</vuln:Note>
      <vuln:Note
        Title="Microsoft"
        Type="CNA"
        Ordinal="30">Microsoft</vuln:Note>
      <vuln:Note
        Title="Customer Action Required"
        Type="Other"
        Ordinal="40">Yes</vuln:Note>
    </vuln:Notes>

  <vuln:Vulnerability
    Ordinal="865">
    <vuln:Title>Windows Print Configuration Elevation of Privilege Vulnerability</vuln:Title>
    <vuln:Notes>
      <vuln:Note
        Title="Description"
        Type="Description"
        Ordinal="0">&lt;p&gt;Double free in Microsoft Printer Drivers allows an authorized attacker to elevate privileges locally.&lt;/p&gt;
</vuln:Note>
      <vuln:Note

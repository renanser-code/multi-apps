    <vuln:Title>Windows Kernel Information Disclosure Vulnerability</vuln:Title>
    <vuln:Notes>
      <vuln:Note
        Title="Description"
        Type="Description"
        Ordinal="0">&lt;p&gt;Out-of-bounds read in Windows Kernel allows an unauthorized attacker to disclose information over a network.&lt;/p&gt;
</vuln:Note>

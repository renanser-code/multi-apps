  <vuln:Vulnerability
    Ordinal="580">
    <vuln:Title>Windows Spaceport.sys Elevation of Privilege Vulnerability</vuln:Title>
    <vuln:Notes>
      <vuln:Note
        Title="Description"
        Type="Description"
        Ordinal="0">&lt;p&gt;Missing authentication for critical function in Windows Spaceport.sys allows an authorized attacker to elevate privileges locally.&lt;/p&gt;
</vuln:Note>
      <vuln:Note
        Title="FAQ"
        Type="FAQ"
        Ordinal="10">&lt;p&gt;&lt;strong&gt;What privileges could be gained by an attacker who successfully exploited this vulnerability?&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;An attacker who successfully exploited this vulnerability could gain SYSTEM privileges.&lt;/p&gt;
</vuln:Note>
      <vuln:Note
        Title="Windows Spaceport.sys"
        Type="Tag"
        Ordinal="20">Windows Spaceport.sys</vuln:Note>

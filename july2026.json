    <vuln:CWE
      ID="CWE-863">Incorrect Authorization</vuln:CWE>
    <vuln:CWE
      ID="CWE-90">Improper Neutralization of Special Elements used in an LDAP Query ('LDAP Injection')</vuln:CWE>

    <vuln:Notes>
      <vuln:Note
        Title="Description"
        Type="Description"
        Ordinal="0">&lt;p&gt;Improper authorization in Microsoft Office SharePoint allows an authorized attacker to elevate privileges over a network.&lt;/p&gt;
</vuln:Note>
      <vuln:Note

  <vuln:Vulnerability
    Ordinal="544">
    <vuln:Title>Windows Zero Trust DNS Security Feature Bypass Vulnerability</vuln:Title>
    <vuln:Notes>
      <vuln:Note
        Title="Description"
        Type="Description"
        Ordinal="0">&lt;p&gt;Improper privilege management in Microsoft Windows DNS allows an authorized attacker to bypass a security feature locally.&lt;/p&gt;
</vuln:Note>
      <vuln:Note
        Title="FAQ"
        Type="FAQ"
        Ordinal="10">&lt;p&gt;&lt;strong&gt;What kind of security feature could be bypassed by successfully exploiting this vulnerability?&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;An attacker who successfully exploited this vulnerability could bypass Zero Trust DNS (ZTDNS) policy enforcement.&lt;/p&gt;
</vuln:Note>
      <vuln:Note
        Title="Windows DNS"
        Type="Tag"
        Ordinal="20">Windows DNS</vuln:Note>
      <vuln:Note
        Title="Microsoft"
        Type="CNA"
        Ordinal="30">Microsoft</vuln:Note>

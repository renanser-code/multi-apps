  <vuln:Vulnerability
    Ordinal="756">
    <vuln:Title>.NET Security Feature Bypass Vulnerability</vuln:Title>
    <vuln:Notes>
      <vuln:Note
        Title="Description"
        Type="Description"
        Ordinal="0">&lt;p&gt;Incorrect authorization in .NET allows an unauthorized attacker to bypass a security feature over a network.&lt;/p&gt;
</vuln:Note>
      <vuln:Note
        Title="FAQ"
        Type="FAQ"
        Ordinal="10">&lt;p&gt;&lt;strong&gt;What kind of security feature could be bypassed by successfully exploiting this vulnerability?&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;The authentication feature could be bypassed as this vulnerability allows impersonation.&lt;/p&gt;
</vuln:Note>
      <vuln:Note

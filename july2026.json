  <vuln:Vulnerability
    Ordinal="1074">
    <vuln:Title>Windows Kernel Elevation of Privilege Vulnerability</vuln:Title>
    <vuln:Notes>
      <vuln:Note
        Title="Description"
        Type="Description"
        Ordinal="0">&lt;p&gt;Integer overflow or wraparound in Windows Kernel allows an authorized attacker to elevate privileges locally.&lt;/p&gt;
</vuln:Note>
      <vuln:Note
        Title="FAQ"

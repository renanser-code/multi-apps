        Type="Severity">
        <vuln:Description>Critical</vuln:Description>
        <vuln:ProductID>11902</vuln:ProductID>
      </vuln:Threat>
      <vuln:Threat
        Type="Exploit Status">
        <vuln:Description>Publicly Disclosed:No;Exploited:No;Latest Software Release:Exploitation Less Likely</vuln:Description>
      </vuln:Threat>
    </vuln:Threats>

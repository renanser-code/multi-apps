  <vuln:Vulnerability
    Ordinal="552">
    <vuln:Title>Windows Key Guard Security Feature Bypass Vulnerability</vuln:Title>
    <vuln:Notes>
      <vuln:Note
        Title="Description"
        Type="Description"
        Ordinal="0">&lt;p&gt;Use of a cryptographic primitive with a risky implementation in Windows Key Guard allows an authorized attacker to bypass a security feature locally.&lt;/p&gt;
</vuln:Note>
      <vuln:Note
        Title="FAQ"
        Type="FAQ"
        Ordinal="10">&lt;p&gt;&lt;strong&gt;What kind of security feature could be bypassed by successfully exploiting this vulnerability?&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;The authentication feature could be bypassed as this vulnerability allows impersonation.&lt;/p&gt;
</vuln:Note>
      <vuln:Note
        Title="Windows Key Guard"
        Type="Tag"
        Ordinal="20">Windows Key Guard</vuln:Note>
      <vuln:Note
        Title="Microsoft"
        Type="CNA"
        Ordinal="30">Microsoft</vuln:Note>
      <vuln:Note

    <vuln:Title>Windows Kernel-Mode Driver Elevation of Privilege Vulnerability</vuln:Title>
    <vuln:Notes>
      <vuln:Note
        Title="Description"
        Type="Description"
        Ordinal="0">&lt;p&gt;Use after free in Windows Kernel-Mode Drivers allows an authorized attacker to elevate privileges locally.&lt;/p&gt;
</vuln:Note>

  <vuln:Vulnerability
    Ordinal="575">
    <vuln:Title>Windows Server Update Service (WSUS) Tampering Vulnerability</vuln:Title>
    <vuln:Notes>
      <vuln:Note
        Title="Description"
        Type="Description"
        Ordinal="0">&lt;p&gt;Uncaught exception in Windows Server Update Service allows an unauthorized attacker to perform tampering over a network.&lt;/p&gt;
</vuln:Note>
      <vuln:Note
        Title="FAQ"
        Type="FAQ"
        Ordinal="10">&lt;p&gt;&lt;strong&gt;According to the CVSS metrics, successful exploitation of this vulnerability could lead to major loss of availability (A:H). What does that mean for this vulnerability?&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;An attacker can send specially crafted packets which could affect availability of the service and result in Denial of Service (DoS).&lt;/p&gt;
</vuln:Note>
      <vuln:Note
        Title="Windows Server Update Service"
        Type="Tag"
        Ordinal="20">Windows Server Update Service</vuln:Note>
      <vuln:Note
        Title="Microsoft"
        Type="CNA"
        Ordinal="30">Microsoft</vuln:Note>
      <vuln:Note
        Title="Customer Action Required"
        Type="Other"
        Ordinal="40">Yes</vuln:Note>
    </vuln:Notes>

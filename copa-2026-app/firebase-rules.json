rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Users Collection Rules
    // Anyone can read leaderboard scores, but users can only write/edit their own profile document
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // Profiles cannot be self-deleted to keep rankings consistent
    }

    // 2. Private Groups Collection Rules
    // Authenticated users can create groups. Anyone inside the group (member code check) can read and modify group members.
    match /groups/{groupId} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.ownerId == request.auth.uid || 
        !exists(/databases/$(database)/documents/groups/$(groupId))
      );
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // 3. Match Predictions Collection Rules
    // Anyone can inspect predictions after kick-off, but users can only edit their own predictions before kick-off.
    match /predictions/{predictionId} {
      allow read: if true;
      allow create, update: if request.auth != null && 
                            request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // 4. Global Leaderboard Rankings
    match /rankings/{rankingId} {
      allow read: if true;
      allow write: if false; // System-controlled only, read-only for clients
    }
  }
}
